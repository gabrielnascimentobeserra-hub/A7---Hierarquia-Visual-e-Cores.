
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tópico 6 - Hierarquia Visual</title>

  <style>
    /* Configurações gerais */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 24px;
      background-color: #f1f5f9;
    }

    /* Card do produto */
    .product-card {
      width: 100%;
      max-width: 380px;
      background-color: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.10);
    }

    /* Imagem e selo */
    .product-image {
      position: relative;
      background-color: #f8fafc;
    }

    .product-image img {
      display: block;
      width: 100%;
      height: 230px;
      object-fit: cover;
    }

    .tag {
      position: absolute;
      top: 16px;
      left: 16px;
      padding: 7px 10px;
      border-radius: 5px;
      background-color: #fee2e2;
      color: #b91c1c;
      font-size: 11px;
      font-weight: 700;
    }

    /* Informações do produto */
    .product-info {
      padding: 24px;
    }

    .category {
      color: #64748b;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
    }

    h1 {
      margin-top: 10px;
      margin-bottom: 12px;
      color: #1e293b;
      font-size: 26px;
      line-height: 1.2;
      font-weight: 800;
    }

    .description {
      margin-bottom: 20px;
      color: #64748b;
      font-size: 14px;
      line-height: 1.6;
    }

    /* Preços */
    .price-container {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .price {
      color: #0f766e;
      font-size: 28px;
      font-weight: 800;
    }

    .old-price {
      color: #94a3b8;
      font-size: 15px;
      text-decoration: line-through;
    }

    .discount {
      margin-top: 6px;
      margin-bottom: 20px;
      color: #0f766e;
      font-size: 13px;
      font-weight: 700;
    }

    /* Botão de compra */
    .buy-button {
      width: 100%;
      padding: 15px;
      border: none;
      border-radius: 8px;
      background-color: #0f766e;
      color: #ffffff;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .buy-button:hover {
      background-color: #115e59;
    }

    /* Informação complementar */
    .shipping {
      margin-top: 14px;
      color: #64748b;
      font-size: 11px;
      text-align: center;
      line-height: 1.5;
    }
  </style>
</head>

<body>

  <main class="product-card">

    <div class="product-image">
      <img
        src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=800&q=80"
        alt="Headphone Bluetooth"
      >
      <span class="tag">MAIS VENDIDO</span>
    </div>

    <div class="product-info">

      <span class="category">ÁUDIO PREMIUM</span>

      <h1>Headphone Bluetooth</h1>

      <p class="description">
        Som imersivo, conforto prolongado e bateria
        de longa duração para acompanhar sua rotina.
      </p>

      <div class="price-container">
        <p class="price">R$ 249,90</p>
        <p class="old-price">R$ 399,90</p>
      </div>

      <p class="discount">38% de desconto</p>

      <button class="buy-button" type="button">
        Comprar agora
      </button>

      <p class="shipping">
        Pagamento seguro • Envio para todo o Brasil
      </p>

    </div>
  </main>

</body>
</html>
